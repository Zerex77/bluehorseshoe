// Cloudflare setup for the relay. See README.md for the full steps.
//   npx wrangler login
//   npx wrangler d1 create bluehorseshoe-relay      -> paste the database_id it prints below
//   npx wrangler deploy
{
  "name": "bluehorseshoe-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "bluehorseshoe-relay", "database_id": "PASTE-DATABASE-ID-HERE" }
  ]
}
