// Cloudflare Workers Builds deploys the Horseshoe Ticker app + relay (the relay/ folder) from here,
// so the Git connection can use the repo's top level with the default settings.
// Keep in step with relay/wrangler.jsonc (used when deploying from inside relay/).
{
  "name": "bluehorseshoe-relay",
  "main": "relay/src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./relay/public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "bluehorseshoe-relay", "database_id": "ff72fff7-55be-4f7b-8983-bec3a3efc29c" }
  ]
}
